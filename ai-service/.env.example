# MindVault AI Service Environment Configuration

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Vector Database Selection: "chroma" | "pinecone" | "qdrant"
# Set to "pinecone" for persistent free-tier cloud deployment on Render
VECTOR_DB_TYPE=chroma

# Local ChromaDB
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=mindvault_knowledge

# Hosted Pinecone Serverless Free Tier
# https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mindvault
PINECONE_ENVIRONMENT=us-east-1

# Hosted Qdrant Cloud Free Tier
# https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mindvault_knowledge

# Text Chunking & Retrieval Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5

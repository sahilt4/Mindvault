# MindVault Master Environment Configuration Example
# Copy relevant sections to respective .env files in local dev or configure in cloud dashboards.

# ==============================================================================
# 1. FRONTEND (Vercel)
# ==============================================================================
# Local: http://localhost:5000/api
# Production: https://<your-backend-app>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ==============================================================================
# 2. NODE.JS BACKEND (Render)
# ==============================================================================
PORT=5000
NODE_ENV=development

# MongoDB Connection:
# Local: mongodb://localhost:27017/mindvault
# Production (MongoDB Atlas M0 Free Tier):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mindvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mindvault

# Secret for signing JWT authentication tokens
JWT_SECRET=mindvault_jwt_secret_dev_super_safe_key_987654321

# URL of the Python AI FastAPI service:
# Local: http://127.0.0.1:8000
# Production: https://<your-ai-service-app>.onrender.com
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional: Restrict allowed CORS origin to your Vercel frontend URL
# FRONTEND_URL=https://<your-frontend-app>.vercel.app

# ==============================================================================
# 3. PYTHON AI SERVICE (Render)
# ==============================================================================
# LLM Provider: "gemini" | "openai" | "ollama" | "local"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

# Embeddings: "gemini" | "openai" | "local"
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Vector Database Selection:
# "chroma" (default for local development)
# "pinecone" (recommended for free-tier cloud deployment)
# "qdrant" (alternative free hosted vector cloud)
VECTOR_DB_TYPE=chroma

# ChromaDB Settings (Local)
VECTOR_DB_PATH=./chroma_db
COLLECTION_NAME=mindvault_knowledge

# Pinecone Settings (Hosted Serverless Free Tier)
# Get your free API key at https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mindvault
PINECONE_ENVIRONMENT=us-east-1

# Qdrant Settings (Hosted Cloud Free Tier)
# Get your free cluster at https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mindvault_knowledge

# Chunking & Retrieval
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=5
